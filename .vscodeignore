# Source + tooling not needed at runtime. dist/extension.js is the bundled host;
# runtime deps (kokoro-js, @huggingface/transformers, onnxruntime-node, sharp)
# are included from node_modules by vsce (NOT excluded here).
.vscode/**
src/**
webview/**
scripts/**
test/**
media/**
out/**
out.log
.gitignore
.vscodeignore
tsconfig.json
REQUIREMENTS.md
playertest.cjs
pt.mjs
**/*.map
**/.DS_Store
**/.gstack/**
node_modules/**/.cache/**
node_modules/**/*.d.ts
node_modules/**/types/**
node_modules/@types/**
node_modules/@huggingface/transformers/src/**
node_modules/@huggingface/jinja/src/**
node_modules/onnxruntime-web/**
node_modules/@protobufjs/**
node_modules/flatbuffers/**
node_modules/guid-typescript/**
node_modules/long/**
node_modules/platform/**
node_modules/protobufjs/**
node_modules/onnxruntime-node/script/**
node_modules/tar/**

# Trim native binaries for other platforms — this VSIX targets the local one.
# (For multi-platform publishing, build per-target VSIXs instead.)
node_modules/onnxruntime-node/bin/napi-v3/linux/**
node_modules/onnxruntime-node/bin/napi-v3/win32/**
node_modules/onnxruntime-node/bin/napi-v3/darwin/x64/**

# Prune obvious dev weight from the bundled dependency tree.
node_modules/**/*.md
node_modules/**/*.map
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/example/**
node_modules/**/examples/**
node_modules/**/docs/**
node_modules/.bin/**
