{
  "manifest_version": 3,
  "name": "Kokoro Speak",
  "version": "0.0.0",
  "description": "Read web pages and selected text aloud in a natural voice, with the spoken sentence highlighted. Runs entirely on your device.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kokoro Speak",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["activeTab", "contextMenus", "offscreen", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "speak-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Speak selection"
    },
    "read-page": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Read page"
    },
    "pause-resume": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause / resume"
    },
    "stop": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Stop"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
