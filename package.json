{
  "name": "kokoro-speak-vs",
  "displayName": "Kokoro Speak",
  "description": "Read text aloud in any editor using the open-weight Kokoro 82M TTS model.",
  "version": "0.0.1",
  "publisher": "jamesxtan",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesxtan-codemonkey/kokoro-speak-vs.git"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "kokoroSpeak.speakSelection",
        "title": "Kokoro Speak: Speak Selection",
        "category": "Kokoro Speak"
      },
      {
        "command": "kokoroSpeak.speakDocument",
        "title": "Kokoro Speak: Speak Document",
        "category": "Kokoro Speak"
      },
      {
        "command": "kokoroSpeak.pause",
        "title": "Kokoro Speak: Pause / Resume",
        "category": "Kokoro Speak"
      },
      {
        "command": "kokoroSpeak.stop",
        "title": "Kokoro Speak: Stop",
        "category": "Kokoro Speak"
      },
      {
        "command": "kokoroSpeak.selectVoice",
        "title": "Kokoro Speak: Select Voice",
        "category": "Kokoro Speak"
      },
      {
        "command": "kokoroSpeak.speakHello",
        "title": "Kokoro Speak: Speak Hello (M1 spike)",
        "category": "Kokoro Speak"
      }
    ],
    "configuration": {
      "title": "Kokoro Speak",
      "properties": {
        "kokoroSpeak.voice": {
          "type": "string",
          "default": "af_heart",
          "enum": [
            "af_heart", "af_alloy", "af_aoede", "af_bella", "af_jessica",
            "af_kore", "af_nicole", "af_nova", "af_river", "af_sarah", "af_sky",
            "am_adam", "am_echo", "am_eric", "am_fenrir", "am_liam",
            "am_michael", "am_onyx", "am_puck", "am_santa",
            "bf_alice", "bf_emma", "bf_isabella", "bf_lily",
            "bm_daniel", "bm_fable", "bm_george", "bm_lewis"
          ],
          "description": "Kokoro voice (a=American, b=British; f=female, m=male)."
        },
        "kokoroSpeak.speed": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.5,
          "maximum": 2.0,
          "description": "Speaking rate multiplier (0.5–2.0)."
        },
        "kokoroSpeak.bufferSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Audio buffered before playback. 0 = buffer the whole selection and play it as one gapless clip (smoothest, but you wait for synthesis first). A positive value starts playing after that many seconds of audio, at the cost of a brief gap at each segment boundary."
        }
      }
    },
    "keybindings": [
      {
        "command": "kokoroSpeak.speakSelection",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      },
      {
        "command": "kokoroSpeak.pause",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "kokoroSpeak.stop",
        "key": "ctrl+alt+x",
        "mac": "cmd+alt+x"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kokoroSpeak.speakSelection",
          "when": "editorHasSelection",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "spike": "node scripts/spike.mjs",
    "build:ext": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js",
    "build:webview": "esbuild webview/main.ts --bundle --platform=browser --format=esm --outfile=media/main.js",
    "copy:ort": "node scripts/copy-ort.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:ext && npm run build:webview && npm run copy:ort",
    "build:ext:min": "esbuild src/extension.ts --bundle --platform=node --external:vscode --format=cjs --minify --outfile=dist/extension.js",
    "build:webview:min": "esbuild webview/main.ts --bundle --platform=browser --format=esm --minify --outfile=media/main.js",
    "vscode:prepublish": "npm run build:ext:min && npm run build:webview:min && npm run copy:ort",
    "package": "vsce package --no-dependencies",
    "watch": "npm run build -- --watch",
    "test": "node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "dependencies": {
    "kokoro-js": "^1.2.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "3.8.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true,
    "esbuild@0.23.1": true
  }
}
